{
  "expo": {
    "name": "Soma",
    "slug": "universal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/soma-app-icon.png",
    "scheme": "universal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.gkos.soma"
    },
    "android": {
      "package": "dev.gkos.soma",
      "adaptiveIcon": {
        "backgroundColor": "#101624",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@bacons/apple-targets",
      "./plugins/soma-widget/withSomaWidget",
      "./plugins/emulator-cleartext/withEmulatorCleartext",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "soma uses the microphone so you can say what you ate instead of typing it.",
          "speechRecognitionPermission": "soma turns what you say about a meal into text on your device."
        }
      ],
      "expo-background-task",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}